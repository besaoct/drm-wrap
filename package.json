{
  "name": "drm-wrap-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "DRM-Wrap: npm CLI + secure Electron desktop app generator with anti-screen-capture and DRM features",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=drm-wrap",
    "dev": "npm run dev --workspace=drm-wrap-desktop-app",
    "dev:studio": "npm run dev --workspace=drm-wrap-studio",
    "typecheck": "npm run typecheck --workspace=drm-wrap",
    "lint": "npm run lint --workspaces --if-present",
    "license:issue": "node packages/license-admin/scripts/issue-license.js",
    "license:keygen": "node packages/license-admin/scripts/keygen.js",
    "license:gui": "open tools/license-generator.html"
  },
  "author": "besaoct <besaoct@gmail.com>",
  "engines": {
    "node": ">=20"
  },
  "license": "Proprietary"
}
