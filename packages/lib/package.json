{
  "name": "@besaoct/drm-wrap",
  "version": "1.0.0",
  "description": "Convert any website into a secure, DRM-protected Electron desktop app with anti-screen-capture and screen-recording detection.",
  "author": "besaoct",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/besaoct/drm-wrap.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "bin": {
    "drm-wrap": "./dist/cli/index.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": "./dist/core/index.js",
    "./core": "./dist/core/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js && node scripts/copy-template.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "ps-list": "^7.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.10",
    "electron": "^31.3.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  }
}
